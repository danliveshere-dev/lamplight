{
  "name": "lamplight-workspace",
  "version": "0.1.0-beta.5",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/react"
  ],
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "tokens:ecosystem-check": "style-dictionary build --config style-dictionary.config.mjs",
    "build": "npm run tokens:build && npm run build --workspace @lamplight/core && npm run build --workspace @lamplight/react",
    "examples:build": "npm run build && npm run examples:build:only",
    "examples:build:only": "npm run build --prefix examples/vanilla && npm run build --prefix examples/astro && npm run build --prefix examples/react && npm run examples:showcase",
    "test": "npm run build && npm run tokens:check && npm run tokens:ecosystem-check && npm run examples:build:only && node --test test/*.test.mjs && npm test --workspace @lamplight/react",
    "privacy": "node scripts/privacy-scan.mjs",
    "qa:size": "node scripts/gate4/package-qa.mjs --skip-consumers",
    "qa:packages": "node scripts/gate4/package-qa.mjs",
    "qa:browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "qa:chrome": "playwright test --project=local-chrome",
    "qa:website": "node scripts/gate4/website-canary.mjs --commit 37bef99e6d32c55aea395fdcdbe0a2331c88e4ee",
    "gate5:licence": "node scripts/gate5/licence-check.mjs",
    "gate5:security": "node scripts/gate5/public-repo-check.mjs",
    "gate5:check": "npm run gate5:licence && npm run gate5:security && npm run privacy",
    "gate7:prepare": "node scripts/gate7/binary-policy.mjs",
    "gate7:release": "node scripts/gate7/release-manifest-policy.mjs",
    "beta:check": "node scripts/beta/validate.mjs",
    "beta:build": "node scripts/beta/build.mjs",
    "examples:showcase": "node examples/showcase/build.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "astro": "7.4.7",
    "css-tree": "3.2.1",
    "js-yaml": "5.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "style-dictionary": "5.7.1",
    "esbuild": "0.28.2"
  }
}
